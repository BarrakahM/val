<view class="card center"><button type="primary" bindtap="chooseImage">拍照或选择照片</button></view><view wx:if="{{imagePath}}" class="card"><image src="{{imagePath}}" mode="widthFix" style="width:100%"/></view><view wx:if="{{ocrResult}}" class="card"><view class="title">识别结果</view><block wx:for="{{ocrResult.items}}" wx:key="name"><view class="row space-between"><text>{{item.name}}</text><text>¥{{item.amount}}</text></view></block><view class="row space-between" style="margin-top:16rpx"><text>合计</text><text>¥{{ocrResult.total}}</text></view><button class="submit" bindtap="submitReceipt">提交小票</button></view>
