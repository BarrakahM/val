.vip-title{font-size:36rpx;font-weight:700;color:#fff}.points{font-size:36rpx;font-weight:700;color:#fff}.vip{background:linear-gradient(90deg,#f472b6,#f9a8d4);color:#fff;border-radius:16rpx;padding:24rpx}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx;margin:16rpx}.grid-item{background:#f3f4f6;border-radius:12rpx;padding:24rpx;text-align:center}.title{font-size:32rpx;font-weight:700;margin-bottom:16rpx}.service{display:flex;justify-content:space-between;padding:16rpx;border-radius:12rpx;background:#f9fafb;margin-bottom:12rpx}
