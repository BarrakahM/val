<view class="card"><view class="title">皮肤测试</view><form bindsubmit="onSubmit"><view class="q"><text>1. T区情况</text><radio-group name="tzone"><label class="opt"><radio value="油"/>油</label><label class="opt"><radio value="干"/>干</label><label class="opt"><radio value="正常"/>正常</label></radio-group></view><view class="q"><text>2. 脸颊情况</text><radio-group name="cheek"><label class="opt"><radio value="油"/>油</label><label class="opt"><radio value="干"/>干</label><label class="opt"><radio value="敏感"/>敏感</label></radio-group></view><view class="q"><text>3. 主要肌肤问题</text><checkbox-group name="issues"><label class="opt"><checkbox value="痘痘"/>痘痘</label><label class="opt"><checkbox value="泛红"/>泛红</label><label class="opt"><checkbox value="暗沉"/>暗沉</label></checkbox-group></view><button formType="submit" type="primary">提交</button></form></view><view wx:if="{{result}}" class="card"><view class="title">测试结果</view><text>{{result.type}}</text><view class="title" style="margin-top:16rpx">推荐产品</view><block wx:for="{{result.products}}" wx:key="id"><view class="row space-between"><text>{{item.name}}</text><text>¥{{item.price}}</text></view></block></view>
